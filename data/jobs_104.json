(async () => {
  const keywords = ["Product Manager", "Project Manager", "產品經理", "專案經理"];
  const seen = new Set();
  const jobs = [];

  for (const kw of keywords) {
    try {
      const url = `https://www.104.com.tw/jobs/search/api/jobs?keyword=${encodeURIComponent(kw)}&page=1&pagesize=20&order=15`;
      const res = await fetch(url, { headers: { "Referer": "https://www.104.com.tw/jobs/search/" } });
      const json = await res.json();
      const list = json?.data?.list || json?.data || [];
      for (const item of list) {
        const id = String(item.jobNo || item.link?.job || jobs.length);
        if (!id || seen.has(id)) continue;
        seen.add(id);
        const rawLink = item.link?.job || "";
        const fullUrl = rawLink.startsWith("//") ? "https:" + rawLink : (rawLink || "https://www.104.com.tw/");
        jobs.push({
          job_id: id,
          source: "104 Job Bank",
          source_url: fullUrl,
          job_title_original: item.jobName || "",
          company_name_original: item.custName || "",
          location: item.jobAddrNoDesc || "Taiwan",
          salary_display: item.salaryDesc || "Not provided",
          posting_date: item.appearDate || "2026-11-24",
          job_description_original: item.description || item.jobName || ""
        });
      }
    } catch (e) { console.log(kw, e); }
  }

  const blob = new Blob([JSON.stringify({ total: jobs.length, synced_at: new Date().toISOString(), jobs }, null, 2)], { type: "application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "jobs_104.json";
  a.click();
  console.log("Downloaded jobs:", jobs.length);
})();
